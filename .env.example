# Required: Google Sheets configuration
GOOGLE_SHEET_ID=your-sheet-id-here
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_TOKEN_PATH=./.tokens/token.json

# Optional: Anthropic API (only if enabling Claude features)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Feature flags
ENABLE_CLAUDE_FALLBACK=False
TC_ANALYZER_MODE=keyword
ENABLE_JS_RENDERING=True
JS_RENDERING_SUSPICION_THRESHOLD=3
JS_RENDERING_TIMEOUT_SECONDS=15

# Performance
HTTP_TIMEOUT_SECONDS=8
DUCKDUCKGO_TIMEOUT_SECONDS=12
TOTAL_DISCOVERY_BUDGET_SECONDS=150
TOTAL_TC_BUDGET_SECONDS=60

# Genie backend database
#   Leave GENIE_DB_URL unset → SQLite at ./genie.db (local dev default).
#   Set it to a Postgres DSN in production (Render/Railway/managed PG):
# GENIE_DB_URL=postgresql://user:pass@host:5432/genie
# GENIE_DB_PATH=./genie.db        # SQLite path override (when GENIE_DB_URL unset)
# OPR_API_KEY=                    # OpenPageRank (Keywords Everywhere) for PR metric
# GENIE_CORS_ORIGINS=http://localhost:3000   # comma-separated allowed frontends

# Genie API auth (shared secret). Unset → auth DISABLED (local dev).
# Set in production to require X-API-Key / Authorization: Bearer on every
# route except /health. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# GENIE_API_KEY=
# The frontend must send the SAME value via NEXT_PUBLIC_GENIE_API_KEY
# (set in genie/web/.env.local or Vercel env). Note: NEXT_PUBLIC_* is
# visible in the browser bundle — deters casual abuse, not a true secret.
# --- Genie-V3 Layer 1 (model choice architecture) ---
# Cascade order; first non-empty schema-valid answer wins. Comma-separated.
# Default: google/gemini-3.7-flash,openai/gpt-4o-mini,anthropic/claude-sonnet-5
GENIE_MODEL_TIERS=
GENIE_LLM_TIMEOUT=90
GENIE_LLM_RETRIES=1

# Google Search via Serper — powers the Layer-2 search rescue and the
# category-aware capability expansion. Without it both degrade to no-ops.
SERPER_API_KEY=
# Concurrent searches across ALL code paths (quota is per account).
GENIE_SEARCH_CONCURRENCY=3
# Opportunistic expansion: 1 search per missing ERP/LMS/Fee-Payment pillar.
GENIE_CAPABILITY_EXPANSION=1

# --------------------------------------------------------------------------- #
#  Residential proxy (Bright Data) — geo-routed fetches
# --------------------------------------------------------------------------- #
# Off unless all of USE_PROXY + the three RESIDENTIAL_PROXY_* values are set;
# everything falls back to a direct connection when unconfigured.
#
# Why it matters: a US-hosted run of buet.ac.bd returned NO portals, and the
# same run through a Bangladesh exit returned the correct one. The crawl did not
# error — it fetched a different page. A missing proxy looks like "this
# university has no portal", not like a network problem.
USE_PROXY=0

# The country THIS agent egresses from. Domains in it skip the proxy, because a
# direct connection is already local. `in` for the office; set `us` (or
# whatever applies) on a hosted deploy, or Indian universities — the largest
# slice of the org list — get fetched direct from the wrong continent.
PROXY_HOME_CC=in

# host:port ONLY. A scheme here produces http://user:pass@http://host and every
# fetch fails; /health reports `gateway_has_scheme` to catch it.
RESIDENTIAL_PROXY_GATEWAY=brd.superproxy.io:33335
RESIDENTIAL_PROXY_USER=
RESIDENTIAL_PROXY_PASS=
# Provider-specific; {cc} is the ISO2 exit country. Leave unset for the default.
# RESIDENTIAL_PROXY_USER_TEMPLATE={user}-country-{cc}

# The proxy FAILS CLOSED: an unwhitelisted egress IP returns 401 and every
# portal is recorded dead. Whitelist the host's outbound IPs before enabling.

# --------------------------------------------------------------------------- #
#  Transport policy
# --------------------------------------------------------------------------- #
# Portals must be https. Checked on the FINAL url after redirects, so a portal
# published as http that redirects to https is kept (and recorded at its https
# address). Only genuinely http-only logins are dropped.
#
# V2 enforced this in agent/legacy/magic.py and legacy/stages/discovery.py; the
# V3 rewrite lost it, so V3 shipped plain-http logins until 2026-09-21. Dropped
# portals are reported in the `notes` column, never silently discarded.
#
# Set 0 only for an investigation run where you want to see what is out there.
GENIE_REQUIRE_HTTPS=1
